              "raw": "{\"nombre\":\"Nuevo Usuario\",\"email\":\"nuevo@test.com\",\"password\":\"test123\",\"rol\":\"ROLE_COORDINADOR\"}"
            },
            "url": "{{baseUrl}}/auth/register"
