            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{adminEmail}}\"}"
            }
          }
        },
        {
          "name": "Refresh token invalido 401",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/refresh",
            "description": "Caso autorizacion: refresh falso -> 401.",
