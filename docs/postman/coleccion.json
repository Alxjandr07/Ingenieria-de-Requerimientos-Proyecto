            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"email-invalido\",\"password\":\"test123\"}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Logout (cierre de sesion 204)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/logout",
            "description": "Caso exito: con Bearer valido revoca el token en Redis -> 204.",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "Forgot password (email valido 200)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/forgot-password",
